# ==========================================
# Configuración del Backend Guardianes del Planeta
# ==========================================
SERVER_PORT=8080

# ==========================================
# Configuración de Base de Datos MySQL
# ==========================================
DB_HOST=mysqldb
DB_PORT=3306
DB_NAME=guardianes_planeta_db
DB_USER=guardian_user
DB_PASSWORD=guardian_secret_pass
MYSQL_ROOT_PASSWORD=root_secure_password
JPA_DDL_AUTO=update
SHOW_SQL=true

# ==========================================
# Configuración de Seguridad y JWT
# ==========================================
# Clave HMAC-SHA256 de al menos 256 bits (32 bytes / 64 caracteres hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Duración en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000
